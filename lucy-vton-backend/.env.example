FAL_KEY=8ebc4078-b77b-44bb-b53f-0d62bd86e648:a374f8da5e26b446fbcf1ade328cbb24
PORT=3000
# Origens do frontend, separadas por vírgula (o dev server do cheerful-pal-advisor roda na 8080)
ALLOWED_ORIGIN=http://localhost:8080
# Apps realtime para os quais o backend emite token
ALLOWED_REALTIME_APPS=decart/lucy2-vton/realtime
TOKEN_RATE_LIMIT_PER_MINUTE=10
# Decart direto (Lucy VTON 3.5). Chave em platform.decart.ai — nunca no frontend.
DECART_API_KEY=your_decart_key_here
DECART_MODEL=lucy-vton-3.5
# Duração máxima de cada sessão, imposta pela Decart (mínimo 10s)
DECART_MAX_SESSION_SECONDS=45
# Defina como 1 quando rodar atrás de um proxy reverso
TRUST_PROXY=
